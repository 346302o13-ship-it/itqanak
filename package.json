{
  "name": "itqanak",
  "version": "0.1.0",
  "private": true,
  "description": "ITQANAK (إتقانك) platform foundation",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=22.14.0 <23",
    "pnpm": ">=9.15.4 <10"
  },
  "pnpm": {
    "overrides": {
      "nanoid@<3.3.18": "3.3.18"
    }
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:smoke": "playwright test",
    "test:auth-e2e": "playwright test --config playwright.auth.config.ts",
    "test:requests-e2e": "playwright test --config playwright.requests.config.ts",
    "db:migrate": "pnpm --filter @itqanak/db db:migrate",
    "db:status": "pnpm --filter @itqanak/db db:status",
    "db:verify": "pnpm --filter @itqanak/db db:verify",
    "auth:create-admin": "pnpm --filter @itqanak/auth auth:create-admin",
    "auth:grant-role": "pnpm --filter @itqanak/auth auth:grant-role",
    "auth:revoke-role": "pnpm --filter @itqanak/auth auth:revoke-role",
    "auth:cleanup-expired": "pnpm --filter @itqanak/auth auth:cleanup-expired",
    "auth:list-sessions": "pnpm --filter @itqanak/auth auth:list-sessions",
    "auth:benchmark-password": "pnpm --filter @itqanak/auth auth:benchmark-password",
    "catalog:seed-development": "pnpm --filter @itqanak/catalog catalog:seed-development",
    "requests:cleanup-drafts": "pnpm --filter @itqanak/requests requests:cleanup-drafts",
    "storage:verify": "pnpm --filter @itqanak/requests storage:verify",
    "storage:cleanup-orphans": "pnpm --filter @itqanak/requests storage:cleanup-orphans",
    "files:scan-pending": "pnpm --filter @itqanak/requests files:scan-pending",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.55.1",
    "@types/node": "22.15.3",
    "@types/nodemailer": "8.0.1",
    "eslint": "9.35.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.5.3",
    "turbo": "2.5.6",
    "typescript": "5.9.2",
    "typescript-eslint": "8.42.0",
    "vitest": "3.2.4"
  }
}
