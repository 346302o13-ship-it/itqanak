{
  "name": "@itqanak/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "itqanak-db": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:status": "tsx src/cli.ts status",
    "db:verify": "tsx src/cli.ts verify"
  },
  "dependencies": {
    "@itqanak/config": "workspace:*",
    "@itqanak/observability": "workspace:*",
    "postgres": "3.4.7"
  },
  "devDependencies": {
    "tsx": "4.19.3"
  }
}
