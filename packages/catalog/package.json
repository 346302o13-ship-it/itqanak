{
  "name": "@itqanak/catalog",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "itqanak-catalog": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "catalog:seed-development": "tsx src/cli.ts seed-development"
  },
  "dependencies": {
    "@itqanak/config": "workspace:*",
    "@itqanak/db": "workspace:*"
  },
  "devDependencies": {
    "tsx": "4.19.3"
  }
}
