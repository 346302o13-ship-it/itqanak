# Development-only values. Never place production secrets in this file.
NODE_ENV=development
APP_ENV=development
APP_NAME=ITQANAK
DEFAULT_LOCALE=ar
PUBLIC_APP_URL=http://127.0.0.1:8080
ADMIN_APP_URL=http://127.0.0.1:8080/ar/admin
DATABASE_URL=postgresql://itqanak@postgres:5432/itqanak
REDIS_URL=redis://redis:6379
# Repository-relative for local pnpm commands. Containers override this path.
MIGRATIONS_DIR=migrations
LOG_LEVEL=info
WHATSAPP_MODE=disabled
WHATSAPP_PHONE_NUMBER_ID=1260466807145770
WHATSAPP_TEMPLATE_NAME=new_service_request_ar1
WHATSAPP_TEMPLATE_LANGUAGE=ar
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/lib/itqanak/uploads
MAX_UPLOAD_BYTES=26214400
# Authentication. Generate AUTH_EMAIL_PAYLOAD_KEY locally with a cryptographically
# random 32-byte base64 value; never commit it. Email remains disabled by default.
AUTH_STUDENT_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_STUDENT_SESSION_IDLE_TTL_SECONDS=604800
AUTH_ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=43200
AUTH_ADMIN_SESSION_IDLE_TTL_SECONDS=7200
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_RATE_LIMIT_ENABLED=true
EMAIL_DELIVERY_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_NAME=ITQANAK
SMTP_FROM_ADDRESS=
TERMS_VERSION=2026-08
PRIVACY_VERSION=2026-08
# AUTH_EMAIL_PAYLOAD_KEY=
# SMTP_PASSWORD=
