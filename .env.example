# Development-only values. Never place production secrets in this file.
NODE_ENV=development
APP_ENV=development
APP_NAME=ITQANAK
DEFAULT_LOCALE=ar
PUBLIC_APP_URL=http://127.0.0.1:8080
ADMIN_APP_URL=http://127.0.0.1:8080
# Protect the administrative hostname with a Cloudflare Access self-hosted
# application. Keep disabled until all three values are copied from Zero Trust.
CLOUDFLARE_ACCESS_MODE=disabled
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUDIENCE=
CLOUDFLARE_ACCESS_ADMIN_EMAIL=
ACADEMIC_INTEGRITY_VERSION=2026-08
DATABASE_URL=postgresql://itqanak@postgres:5432/itqanak
REDIS_URL=redis://redis:6379
# Repository-relative for local pnpm commands. Containers override this path.
MIGRATIONS_DIR=migrations
LOG_LEVEL=info
WHATSAPP_MODE=disabled
WHATSAPP_PHONE_NUMBER_ID=1260466807145770
WHATSAPP_TEMPLATE_NAME=new_service_request_ar1
WHATSAPP_TEMPLATE_LANGUAGE=ar
WHATSAPP_GRAPH_API_VERSION=v25.0
WHATSAPP_SUPPORT_RECIPIENT_E164=+966564202263
WHATSAPP_MAX_ATTEMPTS=8
# Required when enabled. Set this to the activation instant so older outbox
# fixtures and historical requests are never delivered to the support number.
WHATSAPP_NOTIFICATIONS_NOT_BEFORE=
# The approved template must have exactly three body text variables: event
# type, reference, and summary. Never commit WHATSAPP_ACCESS_TOKEN.
# WHATSAPP_ACCESS_TOKEN=
# Ad pixels: optional, off by default. Setting one loads that pixel's base
# snippet (PageView only) and adds its domain to the CSP; see layout.tsx and
# next.config.ts.
FB_PIXEL_ID=
TIKTOK_PIXEL_ID=
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=/var/lib/itqanak/private-uploads
UPLOAD_MAX_FILE_BYTES=20971520
UPLOAD_MAX_FILES_PER_REQUEST=10
UPLOAD_MAX_TOTAL_BYTES_PER_REQUEST=104857600
# For the opt-in MinIO storage profile, set STORAGE_DRIVER=s3 and provide
# non-production credentials locally. Never commit real object-store secrets.
# STORAGE_S3_ENDPOINT=http://minio:9000
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_BUCKET=itqanak-private
# STORAGE_S3_FORCE_PATH_STYLE=true
# STORAGE_S3_ACCESS_KEY_ID=
# STORAGE_S3_SECRET_ACCESS_KEY=
# ClamAV is opt-in in development: docker compose --profile antivirus up -d.
# Disabled mode never marks an attachment CLEAN.
FILE_SCAN_MODE=disabled
CLAMAV_HOST=clamav
CLAMAV_PORT=3310
CLAMAV_CONNECT_TIMEOUT_MS=3000
CLAMAV_SCAN_TIMEOUT_MS=30000
FILE_SCAN_MAX_ATTEMPTS=5
# Public maintenance decisions are cached briefly per Web process. The admin
# and health surfaces are always excluded from the maintenance gate.
OPERATIONAL_STATE_CACHE_TTL_MS=2000
# Authentication. Generate AUTH_EMAIL_PAYLOAD_KEY locally with a cryptographically
# random 32-byte base64 value; never commit it. Email remains disabled by default.
AUTH_STUDENT_SESSION_ABSOLUTE_TTL_SECONDS=2592000
AUTH_STUDENT_SESSION_IDLE_TTL_SECONDS=604800
AUTH_ADMIN_SESSION_ABSOLUTE_TTL_SECONDS=43200
AUTH_ADMIN_SESSION_IDLE_TTL_SECONDS=7200
AUTH_EMAIL_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=1800
AUTH_RATE_LIMIT_ENABLED=true
EMAIL_DELIVERY_MODE=disabled
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM_NAME=ITQANAK
SMTP_FROM_ADDRESS=
TERMS_VERSION=2026-08
PRIVACY_VERSION=2026-08
# AUTH_EMAIL_PAYLOAD_KEY=
# SMTP_PASSWORD=
