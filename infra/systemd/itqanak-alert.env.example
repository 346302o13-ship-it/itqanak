# Root-owned systemd environment for Telegram alerting.
# Install as /etc/itqanak/alert.env with mode 0600.
#
#   install -D -m 0600 infra/systemd/itqanak-alert.env.example /etc/itqanak/alert.env
#
# Create the bot with @BotFather, then get the numeric chat id by messaging the
# bot once and reading https://api.telegram.org/bot<token>/getUpdates.
TELEGRAM_BOT_TOKEN=000000000:replace-with-bot-token
TELEGRAM_CHAT_ID=000000000

# Paths for check-monitoring-alerts.sh (same values as backup.env).
ITQANAK_COMPOSE_FILE=/root/itqanak/compose.production.yaml
ITQANAK_COMPOSE_ENV_FILE=/root/itqanak/.env.production
ITQANAK_COMPOSE_PROJECT_NAME=itqanak

# Optional threshold overrides (defaults shown).
# ALERT_WORKER_STALE_SECONDS=180
# ALERT_OUTBOX_PENDING_MAX=5000
# ALERT_OUTBOX_OLDEST_HOURS=24
# ALERT_PENDING_SCAN_MAX=50
