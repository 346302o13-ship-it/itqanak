# Root-owned systemd environment for the daily PostgreSQL backup and the
# off-host replication + restore-verification timers.
# Install as /etc/itqanak/backup.env with mode 0600. Update the absolute paths
# if the release artifact is not /root/itqanak.
#
#   install -D -m 0600 infra/systemd/itqanak-backup.env.example /etc/itqanak/backup.env
#
ITQANAK_COMPOSE_FILE=/root/itqanak/compose.production.yaml
ITQANAK_COMPOSE_ENV_FILE=/root/itqanak/.env.production
ITQANAK_COMPOSE_PROJECT_NAME=itqanak

# --- Off-host database dump copy (itqanak-backup.service) ---------------------
# Refuse a local-only backup in production. Set to "false" only for a deliberate
# single-host dev deployment.
BACKUP_REQUIRE_OFFSITE=true
# rclone destination for the dump + metadata. The remote is defined entirely by
# RCLONE_CONFIG_* below (no rclone config file is read).
#   BACKUP_S3_URI=offhost:itqanak-backups/postgres

# --- Off-host attachment mirror (itqanak-object-sync.service) ----------------
#   OBJECT_SYNC_SOURCE=minio:itqanak-private
#   OBJECT_SYNC_TARGET=offhost:itqanak-attachments
#   OBJECT_SYNC_REQUIRE=true

# --- rclone remotes (example: Backblaze B2 as the off-host provider) ---------
# Off-host target. Use an application key scoped to a single dedicated bucket.
#   RCLONE_CONFIG_OFFHOST_TYPE=s3
#   RCLONE_CONFIG_OFFHOST_PROVIDER=Other
#   RCLONE_CONFIG_OFFHOST_ENDPOINT=https://s3.eu-central-003.backblazeb2.com
#   RCLONE_CONFIG_OFFHOST_ACCESS_KEY_ID=REPLACE
#   RCLONE_CONFIG_OFFHOST_SECRET_ACCESS_KEY=REPLACE
# In-host MinIO source for the attachment mirror (read-only key).
#   RCLONE_CONFIG_MINIO_TYPE=s3
#   RCLONE_CONFIG_MINIO_PROVIDER=Minio
#   RCLONE_CONFIG_MINIO_ENDPOINT=http://minio:9000
#   RCLONE_CONFIG_MINIO_ACCESS_KEY_ID=REPLACE
#   RCLONE_CONFIG_MINIO_SECRET_ACCESS_KEY=REPLACE

# ITQANAK_BACKUP_DIR is already set in .env.production (host dump directory).
