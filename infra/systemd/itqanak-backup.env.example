# Root-owned systemd environment for the daily PostgreSQL backup.
# Install as /etc/itqanak/backup.env with mode 0600. If the release artifact
# moves, update the absolute paths before starting the timer.
#
#   install -D -m 0600 infra/systemd/itqanak-backup.env.example /etc/itqanak/backup.env
#
ITQANAK_COMPOSE_FILE=/root/itqanak/compose.production.yaml
ITQANAK_COMPOSE_ENV_FILE=/root/itqanak/.env.production
ITQANAK_COMPOSE_PROJECT_NAME=itqanak

# Off-host replication target. Leave unset for local-only backups (NOT
# production-safe: a single host loss is then unrecoverable). When set, the
# backup entrypoint copies each dump + metadata file to this prefix and the
# Dockerfile.backup image must ship the matching client (aws-cli / rclone / mc).
#   BACKUP_S3_URI=s3://itqanak-offhost-backups/postgres
