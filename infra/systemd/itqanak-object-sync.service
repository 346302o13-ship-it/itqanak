[Unit]
Description=ITQANAK off-host attachment replication
Documentation=file:///root/itqanak/docs/BACKUP_RESTORE.md
Wants=docker.service
After=docker.service itqanak-backup.service
OnFailure=itqanak-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
EnvironmentFile=/etc/itqanak/backup.env
ExecStart=/usr/bin/docker compose --ansi never --profile operations \
  --env-file ${ITQANAK_COMPOSE_ENV_FILE} \
  --project-name ${ITQANAK_COMPOSE_PROJECT_NAME} \
  --file ${ITQANAK_COMPOSE_FILE} \
  run --rm --env-file /etc/itqanak/backup.env \
  --entrypoint /usr/local/bin/sync-object-storage.sh backup
TimeoutStartSec=60min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
