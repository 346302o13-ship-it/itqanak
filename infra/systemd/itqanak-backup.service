[Unit]
Description=ITQANAK PostgreSQL backup
Documentation=file:///root/itqanak/docs/BACKUP_RESTORE.md
Wants=docker.service
After=docker.service
# Wire an alert once a channel is chosen (Telegram / healthchecks.io / e-mail).
# The unit is separate so a failing backup cannot also break its own notifier.
# OnFailure=itqanak-backup-failure.service

[Service]
Type=oneshot
User=root
Group=root
# Compose paths come from the root-owned environment file, so the same unit
# serves either a /srv release artifact or this host's /root/itqanak checkout.
WorkingDirectory=/
EnvironmentFile=/etc/itqanak/backup.env
ExecStart=/usr/bin/docker compose --ansi never --profile operations \
  --env-file ${ITQANAK_COMPOSE_ENV_FILE} \
  --project-name ${ITQANAK_COMPOSE_PROJECT_NAME} \
  --file ${ITQANAK_COMPOSE_FILE} \
  run --rm backup
TimeoutStartSec=30min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectControlGroups=true
ProtectKernelTunables=true
ProtectKernelModules=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
