[Unit]
Description=ITQANAK backup restore-verification
Documentation=file:///root/itqanak/docs/BACKUP_RESTORE.md
Wants=docker.service
After=docker.service itqanak-backup.service
OnFailure=itqanak-alert@%n.service

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/
EnvironmentFile=/etc/itqanak/backup.env
# Restore the newest local dump into a throwaway itqanak_restore_* database,
# assert schema_migrations completeness and non-negative row counts, then drop
# it. pg_restore --list only proves the archive is readable; a silently broken
# backup chain is otherwise indistinguishable from a good one until recovery.
ExecStart=/bin/sh -c '\
  dir="${ITQANAK_BACKUP_DIR:-/root/itqanak/backups}"; \
  latest="$(ls -1t "$dir"/itqanak-postgres-*.dump 2>/dev/null | head -n1)"; \
  test -n "$latest" || { echo "verify_backup_failed: no local dump found" >&2; exit 1; }; \
  /usr/bin/docker compose --ansi never --profile operations \
    --env-file ${ITQANAK_COMPOSE_ENV_FILE} \
    --project-name ${ITQANAK_COMPOSE_PROJECT_NAME} \
    --file ${ITQANAK_COMPOSE_FILE} \
    run --rm -v "$dir:/verify:ro" \
    --entrypoint /usr/local/bin/verify-backup.sh backup "/verify/$(basename "$latest")"'
TimeoutStartSec=45min
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
