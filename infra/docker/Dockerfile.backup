FROM postgres:17.10-alpine

# bash for the scripts; rclone for the off-host copy (any S3-compatible provider
# — Backblaze B2, Wasabi, AWS — configured via RCLONE_CONFIG_* env in
# /etc/itqanak/backup.env). Without a client here, setting BACKUP_S3_URI alone
# would abort at the tool check.
RUN apk add --no-cache bash rclone

RUN addgroup -S -g 10001 itqanak && adduser -S -G itqanak -u 10001 itqanak

COPY scripts/libpq-service.sh /usr/local/bin/libpq-service.sh
COPY scripts/backup-postgres.sh /usr/local/bin/backup-postgres.sh
COPY scripts/restore-postgres.sh /usr/local/bin/restore-postgres.sh
COPY scripts/verify-backup.sh /usr/local/bin/verify-backup.sh
COPY scripts/sync-object-storage.sh /usr/local/bin/sync-object-storage.sh

RUN chmod 0444 /usr/local/bin/libpq-service.sh \
    && chmod 0555 /usr/local/bin/backup-postgres.sh \
    /usr/local/bin/restore-postgres.sh \
    /usr/local/bin/verify-backup.sh \
    /usr/local/bin/sync-object-storage.sh

USER itqanak
ENTRYPOINT ["/usr/local/bin/backup-postgres.sh"]
