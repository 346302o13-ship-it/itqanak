FROM node:22.23.1-alpine AS base

ENV PNPM_HOME=/pnpm
ENV COREPACK_HOME=/pnpm/corepack
ENV PATH=$PNPM_HOME:$PATH
WORKDIR /workspace

RUN mkdir -p "$COREPACK_HOME" \
    && corepack enable \
    && corepack prepare pnpm@9.15.4 --activate \
    && chmod -R a+rX /pnpm

FROM base AS development

# Source is bind-mounted by compose.yaml. Keeping this target small speeds up
# the edit/run loop and prevents a stale source copy from masking local edits.
COPY . .
RUN --mount=type=cache,id=itqanak-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
CMD ["pnpm", "db:migrate"]

FROM base AS runner

COPY . .
RUN --mount=type=cache,id=itqanak-pnpm-store,target=/pnpm/store \
    pnpm install --frozen-lockfile
# Build the reviewed operator CLIs and their complete dependency closures. This
# keeps first-admin bootstrap, migrations, request maintenance, and isolated CI
# tests available without compiling TypeScript or downloading packages on the
# backend-only production network.
RUN pnpm turbo run build \
    --filter=@itqanak/auth... \
    --filter=@itqanak/content... \
    --filter=@itqanak/finance... \
    --filter=@itqanak/requests...

USER node
# The production migrator must not ask Corepack/npm for a package-manager
# version at runtime: its network is intentionally backend-only.
CMD ["node", "packages/db/dist/cli.js", "migrate"]
